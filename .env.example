# LM_STUDIO_BASE_URL: Base URL for your local LM Studio OpenAI-compatible API.
# Default is http://localhost:1234/v1 — change if you run LM Studio on a different port.
LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"

# LM_STUDIO_MODEL: The exact API Model Identifier shown in LM Studio's model info panel.
LM_STUDIO_MODEL="google/gemma-4-e2b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
